{
  "$schema": "https://mindback.design/schemas/component.schema.json",
  "slug": "button",
  "name": "Button",
  "category": "action",
  "description": "用户主动触发的动作单元。新版契约使用 variant 表达视觉层级、size 表达几何尺寸，避免旧版字段在生成时被误用。",
  "props": {
    "variant": {
      "values": ["filled", "outline", "neutral", "ghost"],
      "default": "filled",
      "description": "视觉层级。filled 主操作；outline 强次级操作；neutral 普通次级操作；ghost 极弱操作，必须放在可见容器或有清晰文字语义的位置"
    },
    "size": {
      "values": ["xLarge", "large", "medium", "small", "mini", "micro"],
      "default": "medium",
      "description": "xLarge 48px / large 44px / medium 36px / small 28px / mini 24px / micro 20px"
    },
    "icon": {
      "values": ["none", "leading", "trailing", "only"],
      "default": "none",
      "description": "图标位置。leading 文字左侧；trailing 文字右侧；only 图标按钮，无文字"
    },
    "fullWidth": {
      "values": [false, true],
      "default": false,
      "description": "是否占满容器宽度。表单底部主操作通常使用 large + filled + fullWidth"
    },
    "selected": {
      "values": [false, true],
      "default": false,
      "description": "是否处于选中态。仅用于分段选择、筛选或状态切换，不用于一次性提交按钮"
    }
  },
  "states": ["idle", "hover", "active", "loading", "disabled"],
  "constraints": [
    {
      "rule": "max_filled_per_view",
      "value": 1,
      "description": "同一视图最多一个 filled 按钮，避免主次失焦"
    },
    {
      "rule": "ghost_requires_visible_surface",
      "value": true,
      "description": "ghost 按钮不能漂在空白背景上，必须依附于卡片、列表行或上下文明确的控制区"
    },
    {
      "rule": "icon_only_requires_aria_label",
      "value": true,
      "description": "icon=only 时必须提供 aria-label"
    },
    {
      "rule": "selected_requires_stateful_context",
      "value": true,
      "description": "selected=true 仅用于可保持状态的选择控件，不用于普通动作按钮"
    }
  ],
  "tokens": {
    "variant.filled.bg": "brand-blue",
    "variant.filled.fg": "bg-0",
    "variant.outline.bg": "transparent",
    "variant.outline.fg": "label-primary",
    "variant.outline.border": "label-primary",
    "variant.neutral.bg": "fill-quaternary",
    "variant.neutral.fg": "label-primary",
    "variant.ghost.bg": "transparent",
    "variant.ghost.fg": "label-primary",
    "selected.bg": "label-primary",
    "selected.fg": "bg-0",
    "size.xLarge.height": "48px",
    "size.large.height": "44px",
    "size.medium.height": "36px",
    "size.small.height": "28px",
    "size.mini.height": "24px",
    "size.micro.height": "20px",
    "size.xLarge.font": "callout",
    "size.large.font": "callout",
    "size.medium.font": "subhead",
    "size.small.font": "caption-1",
    "size.mini.font": "caption-1",
    "size.micro.font": "caption-2",
    "size.xLarge.padding-x": "space-5",
    "size.large.padding-x": "space-4",
    "size.medium.padding-x": "space-4",
    "size.small.padding-x": "space-3",
    "size.mini.padding-x": "space-2",
    "size.micro.padding-x": "space-2",
    "icon.size": "20px",
    "radius": "radius-full"
  },
  "haptics": {
    "active": "light"
  },
  "anatomy": [
    { "part": "container", "tokens": ["variant.*", "radius", "padding-x", "height"] },
    { "part": "icon", "tokens": ["fg", "icon.size", "gap:space-1"] },
    { "part": "label", "tokens": ["fg", "font"] }
  ],
  "doDont": {
    "do": [
      "表单底部主操作使用 variant=filled + size=large + fullWidth=true",
      "卡片内部操作优先使用 size=small 或 size=mini",
      "icon=only 时按钮宽高都是 size 的高度，正方形并提供 aria-label"
    ],
    "dont": [
      "不要在同一视图放两个 variant=filled 的按钮",
      "不要继续使用旧版 Button 字段、旧版变体名或旧版尺寸名",
      "不要在 button 内嵌 button 或链接"
    ]
  }
}
